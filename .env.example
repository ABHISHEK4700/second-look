# Copy this file to .env and fill in your keys.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox > Default Application)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
CURRENCY=USD

# Google Gemini (aistudio.google.com > Get API key)
GEMINI_API_KEY=
# Any Gemini model with function calling + image input; check AI Studio for current names
GEMINI_MODEL=gemini-3-flash-preview

# Demo household
SENDER_NAME=Margaret
GUARDIAN_NAME=Daniel
GUARDIAN_RELATION=son
GUARDIAN_PIN=2468
HOLD_THRESHOLD=40
